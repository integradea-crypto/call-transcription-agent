# Public configuration
N8N_HOST=n8n.example.com
GENERIC_TIMEZONE=Europe/Moscow
N8N_CONCURRENCY_PRODUCTION_LIMIT=2
EXECUTIONS_DATA_MAX_AGE=336

# PostgreSQL. Generate unique values during installation.
POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=REPLACE_DURING_INSTALL
N8N_ENCRYPTION_KEY=REPLACE_DURING_INSTALL

# Bitrix. Store the full REST webhook base URL only in the private runtime .env.
BITRIX_REST_BASE_URL=https://example.bitrix24.ru/rest/USER_ID/WEBHOOK_TOKEN
BITRIX_WEBHOOK_SECRET=REPLACE_DURING_INSTALL
MIN_CALL_DURATION_SECONDS=30
PROCESSING_START_HOUR_MSK=0
PROCESSING_END_HOUR_MSK=24

# Internal n8n -> call-service authentication.
CALLS_API_TOKEN=REPLACE_DURING_INSTALL

# BigQuery destination.
BQ_PROJECT_ID=example-project
BQ_DATASET=call_analytics
BQ_CALLS_TABLE=calls
BQ_LOCATION=EU

# Whisper runtime.
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=ru
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CONCURRENCY=1
WHISPER_VAD_FILTER=false
MAX_UPLOAD_MB=250
